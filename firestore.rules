rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidEmployee(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.role is string && data.role.size() <= 100
        && data.department is string && data.department.size() <= 100
        && (!('pin' in data) || (data.pin is string && data.pin.size() <= 12));
    }
    
    function isValidAttendance(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.employeeId is string && data.employeeId.size() > 0 && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() <= 120
        && (data.type == 'IN' || data.type == 'OUT' || data.type == 'BREAK_START' || data.type == 'BREAK_END')
        && data.timestamp is string && data.timestamp.size() <= 64;
    }
    
    function isValidLeave(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.employeeId is string && data.employeeId.size() > 0 && data.employeeId.size() <= 64
        && data.startDate is string && data.startDate.size() <= 32
        && data.endDate is string && data.endDate.size() <= 32
        && (data.status == 'PENDING' || data.status == 'APPROVED' || data.status == 'REJECTED');
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.employeeId is string && data.employeeId.size() > 0 && data.employeeId.size() <= 64
        && data.title is string && data.title.size() <= 150
        && data.message is string && data.message.size() <= 500
        && (data.type == 'LEAVE_STATUS' || data.type == 'SHIFT_UPDATE' || data.type == 'SYSTEM');
    }

    function isValidCompany(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.supermarketName is string && data.supermarketName.size() > 0 && data.supermarketName.size() <= 100
        && data.password is string && data.password.size() > 0 && data.password.size() <= 100;
    }

    function isValidHelpRequest(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.appName is string && data.appName.size() > 0 && data.appName.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && (data.status == 'PENDING' || data.status == 'RESOLVED');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if true;
      allow create, update: if isValidId(companyId) && isValidCompany(request.resource.data);
      allow delete: if isValidId(companyId);
    }

    match /helpRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow create, update: if isValidId(requestId) && isValidHelpRequest(request.resource.data);
      allow delete: if isValidId(requestId);
    }

    match /test/{testId} {
      allow read: if true;
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if true;
      allow create, update: if isValidId(employeeId) && isValidEmployee(request.resource.data);
      allow delete: if isValidId(employeeId);
    }

    match /attendanceRecords/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create: if isValidId(recordId) && isValidAttendance(request.resource.data);
      allow update, delete: if isValidId(recordId);
    }

    match /leaveRequests/{leaveId} {
      allow get: if isValidId(leaveId);
      allow list: if true;
      allow create, update: if isValidId(leaveId) && isValidLeave(request.resource.data);
      allow delete: if isValidId(leaveId);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow create: if isValidId(notificationId) && isValidNotification(request.resource.data);
      allow update, delete: if isValidId(notificationId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId);
    }
  }
}
